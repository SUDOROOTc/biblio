# Configuration Render pour l'API Biblio.
# Remplacer les valeurs entre chevrons dans le tableau Environment de Render.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=<cle-secrete-generee-par-render>
# Render fournit aussi automatiquement RENDER_EXTERNAL_HOSTNAME.
DJANGO_ALLOWED_HOSTS=biblio-api-3fjk.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://biblio-api-3fjk.onrender.com

# Connexion PostgreSQL Supabase.
POSTGRES_DB=postgres
POSTGRES_USER=<utilisateur-supabase>
POSTGRES_PASSWORD=<mot-de-passe-supabase>
POSTGRES_HOST=<hote-pooler-supabase>
POSTGRES_PORT=5432
PGSSLMODE=require
